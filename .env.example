# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Defina para registrar instantaneamente em um servidor de teste; deixe vazio para comandos globais.
DISCORD_GUILD_ID=
CANAL_POSTAGEM_ID=

# Shopee Affiliate Open API / GraphQL
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Confirme a URL da sua região/conta na documentação do Affiliate Open API.
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# AliExpress Affiliate Open Platform
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
ALIEXPRESS_CURRENCY=BRL
ALIEXPRESS_LANGUAGE=PT
ALIEXPRESS_COUNTRY=BR

# Mercado Livre (a API exige token; com os três abaixo ele é renovado automaticamente)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcional: refresh token de usuário (OAuth). Sem ele, o bot usa o token do app.
ML_REFRESH_TOKEN=
# Alternativa sem renovação automática (expira em 6 h).
ML_ACCESS_TOKEN=
# Exemplo: matt_word=SEU_CODIGO&matt_tool=SEU_TOOL
ML_AFFILIATE_PARAMS=

# Amazon Associados: tag de afiliado (ex.: meusite-20).
AMAZON_TAG=

# Telegram (opcional). Token do @BotFather; chat = @nomedocanal (público) ou ID numérico (-100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp: manda cada oferta pronta para o Canal no privado do dono no Telegram (precisa de TELEGRAM_OWNER_ID).
POST_WHATSAPP=false

# Instagram (API oficial com login do Instagram, conta Profissional). Veja o README.
POST_INSTAGRAM=false
INSTAGRAM_TOKEN=
INSTAGRAM_KEYWORD=QUERO
INSTAGRAM_MAX_PER_DAY=10

# Postagem automática (Shopee). Palavras, intervalo e liga/desliga também podem ser mudados com /auto.
AUTO_ENABLED=false
AUTO_KEYWORDS=fone bluetooth,smartwatch,air fryer
AUTO_INTERVAL_MIN=60
AUTO_POSTS_PER_RUN=1
# Faixa de horas em que pode postar (ex.: 8-23 ou 20-3).
AUTO_HORARIO=8-23
# Canal próprio para as automáticas; vazio usa CANAL_POSTAGEM_ID.
AUTO_CANAL_ID=
# mais-vendidos | maior-comissao | relevancia | menor-preco | maior-preco
AUTO_SORT=mais-vendidos
AUTO_MIN_RATING=4.5
AUTO_MIN_SALES=100
# Fração: 0.03 = 3%
AUTO_MIN_COMMISSION=0.03
AUTO_MAX_PRICE=

# Painel web (só por variável; o resto também pode ser editado no painel)
PAINEL_PORTA=3000
# Vazio = senha criada no primeiro acesso, com o código mostrado no log.
PAINEL_SENHA=

# Operação
DATABASE_PATH=./data/botafiliado.sqlite
REQUEST_TIMEOUT_MS=15000
